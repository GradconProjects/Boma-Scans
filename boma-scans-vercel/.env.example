# Copy to .env.local for local development. In Vercel, add these under Settings -> Environment Variables.

# Turso (libSQL) database. Create one at https://turso.tech, then run `turso db show <name> --url`
# and `turso db tokens create <name>`. For local development you can use file:local.db with no token.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Owner password for /login. At least 32 characters; use a password manager to generate it.
BOMA_SYNC_SECRET=

# Telegram (optional). Create a bot with @BotFather; the chat ID can also be entered in the app.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
