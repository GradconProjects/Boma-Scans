# Copy to .env.local for local development. In Vercel, add these under Settings -> Environment Variables.

# Database. EITHER a Supabase/Postgres connection string (the Vercel Supabase integration
# sets POSTGRES_URL for you; manual: Supabase -> Connect -> "Transaction pooler", port 6543):
POSTGRES_URL=
# OR a Turso/libSQL URL. For local development file:local.db works with no account:
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Owner password for /login. At least 32 characters; use a password manager to generate it.
BOMA_SYNC_SECRET=

# Telegram (optional). Create a bot with @BotFather; the chat ID can also be entered in the app.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI reviewer (optional): a careful second read of every ready-to-enter signal before it is pushed.
# Set one or both keys; switch provider in the app's Telegram panel or with /ai anthropic|openai|off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
